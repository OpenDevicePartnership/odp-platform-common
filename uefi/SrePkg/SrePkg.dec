##
# This Package provides all definitions(including functions, MACROs, structures and library classes)
# and libraries instances for the SRE (Secure Recovery Environment) feature, authored by the ODP group.
#
# Copyright (c) Microsoft Corporation. All rights reserved.
##

[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = SrePkg.dec
  PACKAGE_GUID                   = 94BFEFA4-12DC-4A0B-B830-A87DF595DFFD
  PACKAGE_VERSION                = 1.00

[Includes]
  Include

[Guids]
  
  # SRE Package token space GUID { 212D507B-7906-4CB3-B0C3-08E544E25C34 }
  gSrePkgTokenSpaceGuid = { 0x212d507b, 0x7906, 0x4cb3, { 0xb0, 0xc3, 0x8, 0xe5, 0x44, 0xe2, 0x5c, 0x34 } }

  # Staging UpdateImageTypeId carried by the WIM payload. No FmpDxe instance
  # claims it; it exists only so the peeler can identify the WIM and so stock
  # FmpDxe would harmlessly skip it if the peeler were ever bypassed.
  # { d31b249c-bc66-4cdc-be21-30b1b6566b9c }
  gSreWimStagingGuid = { 0xd31b249c, 0xbc66, 0x4cdc, { 0xbe, 0x21, 0x30, 0xb1, 0xb6, 0x56, 0x6b, 0x9c } }

  # SRE ESRT GUID — the outer CapsuleGuid that Windows Update applies when
  # delivering the SRE capsule. This is the single identification point.
  # { 9777ff5d-3c53-4316-9af3-b99fb9c60fb5 }
  gSreEsrtGuid = { 0x9777ff5d, 0x3c53, 0x4316, { 0x9a, 0xf3, 0xb9, 0x9f, 0xb9, 0xc6, 0x0f, 0xb5 } }


[PcdsFeatureFlag]
  
  # Re-routes the Vol+/Vol- power-on hotkeys in DeviceBootManagerPriorityBoot.
  # When FALSE (default): legacy semantics (Vol+ -> FrontPage, Vol- -> AltBoot).
  # When TRUE: Vol+ dispatches PcdSreBootAppFileGuid as a BootOption from the
  # same FV that hosts BdsDxe; Vol- dispatches the USB-first alt boot order
  # (mirrors the legacy AltBoot path, so the SRE WIM in BP1 survives Windows
  # reimages from a USB installer). Enable per-platform in the DSC alongside
  # PcdSreBootAppFileGuid.
  gSrePkgTokenSpaceGuid.PcdSreHotkeyRoutingEnabled|FALSE|BOOLEAN|0x40000300

[PcdsFixedAtBuild]
  
  # FFS FILE_GUID of the SRE entry application that PcdSreHotkeyRoutingEnabled
  # dispatches on Vol+ at BDS priority-boot time. Default is the zero GUID
  # (treated as "no SRE app installed", priority-boot returns EFI_NOT_FOUND).
  # Enabling platforms must override this with their SRE app's INF FILE_GUID.
  # Default File GUID defined by SrePkg/Application/BpRecoveryLoader/BpRecoveryLoaderApp.inf
  gSrePkgTokenSpaceGuid.PcdSreBootAppFileGuid|{ 0xC1, 0xF2, 0x98, 0x5A, 0x3B, 0x7D, 0x8F, 0x4E, 0xA1, 0x24, 0xB6, 0xE8, 0x91, 0xD4, 0x5C, 0x03 }|VOID*|0x40000301

  # Text device path identifying the SRE mass storage device.
  # Example: L"PciRoot(0x0)/Pci(0x6,0x0)/Pci(0x0,0x0)"
  #   Indicates the device is a PCIe device sitting on root bridge 0, behind a child bridge at Bus 0/Dev 6/Func 0
  gSrePkgTokenSpaceGuid.PcdSreDevicePathString|L""|VOID*|0x40000302

  # Absolute path (from the staging volume root) of the staged SRE recovery
  # image (WIM) on the EFI System Partition. Shared between the pre-reset capsule
  # peeler (which writes the WIM here) and the post-reset SRE FmpDeviceLib (which
  # reads and later deletes it) so both target the same file. Fixed at build.
  gSrePkgTokenSpaceGuid.PcdSreStagingPath|L"\\ODP\\SRE\\OsImage.wim"|VOID*|0x40000303
